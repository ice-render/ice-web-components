{
  "name": "ice-web-components",
  "version": "1.22.0",
  "description": "Swing-style Canvas UI components built on ice-render.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ice-render/ice-web-components.git"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/index.umd.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:js": "rollup -c --environment NODE_ENV:production",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "rollup -c -w --environment NODE_ENV:development",
    "test": "jest --runInBand",
    "types:check": "tsc --noEmit",
    "qa:admin": "node scripts/qa-admin.mjs",
    "qa:gallery": "node scripts/qa-gallery.mjs",
    "qa:workbench": "node scripts/qa-workbench.mjs",
    "qa:xp": "node scripts/qa-xp.mjs",
    "qa:arcade": "node scripts/qa-arcade.mjs",
    "qa:pixel": "node scripts/qa-pixel.mjs",
    "qa:algo": "node scripts/qa-algo.mjs",
    "qa:dos": "node scripts/qa-dos.mjs",
    "qa:counts": "node scripts/lib/qa-counts.mjs",
    "qa:all": "node scripts/qa-all.mjs",
    "qa:perf": "node scripts/qa-perf.mjs",
    "qa:counts:write": "node scripts/lib/qa-counts.mjs --write",
    "docs:api": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs": "npm run docs:api && npm run docs:check",
    "verify": "npm run types:check && npm test && npm run build && npm run docs && node scripts/lib/qa-counts.mjs --check",
    "test:e2e": "npm run build && playwright test",
    "verify:full": "npm run verify && npm run test:e2e && npm run qa:all && npm run qa:perf"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-commonjs": "28.0.1",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-terser": "0.4.4",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.130",
    "babel-jest": "29.7.0",
    "http-server": "^14.1.1",
    "ice-render": "^2.18.0",
    "jest": "29.7.0",
    "rimraf": "5.0.10",
    "rollup": "3.29.5",
    "typescript": "5.9.3"
  },
  "keywords": [
    "canvas",
    "ui",
    "ice-render",
    "swing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "peerDependencies": {
    "ice-render": "^2.18.0"
  }
}
